pipeline {
    agent any
	
	environment {
        APP_NAME = "mymvcapp"
        ACR_NAME = "mytestprojcontanerreg001.azurecr.io"
        IMAGE_NAME = "${ACR_NAME}/${APP_NAME}"
        BUILD_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: 'main',
                credentialsId: 'github-creds',
                url: 'https://github.com/mohamedzaid111/MyTestRepo001.git'
            }
        }

        stage('Build') {
            steps {
                    bat 'dotnet restore WebApplication1\WebApplication1.csproj'
                    bat 'dotnet build WebApplication1\WebApplication1.csproj --configuration Release'
            }
        }

        stage('Run Unit Tests') {
            steps {
                    bat 'dotnet test WebApplication1\WebApplication1.csproj --configuration Release --no-build'
                }

            }
        }

        stage('Build Docker Image') {
            steps {
                bat """
                    docker build -t ${IMAGE_NAME}:${BUILD_TAG} .
                """
            }
        }

        stage('Login to Azure Container Registry') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'acr-creds',
                    usernameVariable: 'ACR_USERNAME',
                    passwordVariable: 'ACR_PASSWORD'
                )]) {

                    bat """
                        echo \$ACR_PASSWORD | docker login ${ACR_NAME} \
                        -u \$ACR_USERNAME --password-stdin
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                bat """
                    docker push ${IMAGE_NAME}:${BUILD_TAG}

                    docker tag ${IMAGE_NAME}:${BUILD_TAG} \
                    ${IMAGE_NAME}:latest

                    docker push ${IMAGE_NAME}:latest
                """
            }
        }
    }

    post {

        success {
            echo 'CI Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }

        always {
            sh 'docker image prune -f'
        }
    }
}